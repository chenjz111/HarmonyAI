.container.data-v-1cf27b2a {
  padding: 20rpx 30rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #F8F8F8;
}

/* 顶部欢迎区 */
.header.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}
.greeting.data-v-1cf27b2a {
  font-size: 40rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
}
.date.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #888780;
  margin-top: 8rpx;
  display: block;
}
.header-avatar.data-v-1cf27b2a {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #EEEDFE;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon.data-v-1cf27b2a {
  font-size: 40rpx;
}

/* 今日推荐处方卡片 */
.prescription-card.data-v-1cf27b2a {
  background: linear-gradient(135deg, #534AB7, #7F77DD);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}
.prescription-header.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.prescription-title.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}
.prescription-tag.data-v-1cf27b2a {
  font-size: 20rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.prescription-info.data-v-1cf27b2a {
  display: flex;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.info-item.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
}
.info-label.data-v-1cf27b2a {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 4rpx;
}
.info-value.data-v-1cf27b2a {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.play-btn.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 18rpx 0;
}
.play-btn-text.data-v-1cf27b2a {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.play-btn-arrow.data-v-1cf27b2a {
  color: #fff;
  font-size: 32rpx;
  margin-left: 8rpx;
}

/* 开始评估入口卡片 */
.assess-card.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.assess-content.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}
.assess-icon.data-v-1cf27b2a {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #E1F5EE;
  display: flex;
  align-items: center;
  justify-content: center;
}
.assess-emoji.data-v-1cf27b2a {
  font-size: 44rpx;
}
.assess-title.data-v-1cf27b2a {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
}
.assess-desc.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #888780;
  margin-top: 6rpx;
  display: block;
}
.assess-arrow.data-v-1cf27b2a {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F1EFE8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow.data-v-1cf27b2a {
  font-size: 36rpx;
  color: #534AB7;
  font-weight: 600;
}

/* 五行五音区域 */
.wuxing-section.data-v-1cf27b2a {
  margin-top: 10rpx;
}
.section-header.data-v-1cf27b2a {
  margin-bottom: 20rpx;
}
.section-title.data-v-1cf27b2a {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
}
.section-subtitle.data-v-1cf27b2a {
  font-size: 22rpx;
  color: #888780;
  margin-top: 4rpx;
  display: block;
}
.wuxing-grid.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.wuxing-item.data-v-1cf27b2a {
  flex: 1;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
}
.wuxing-name.data-v-1cf27b2a {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.wuxing-element.data-v-1cf27b2a {
  color: rgba(255,255,255,0.75);
  font-size: 20rpx;
  display: block;
  margin-top: 6rpx;
}
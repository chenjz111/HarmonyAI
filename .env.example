# HarmonyAI Environment Configuration
# 复制此文件为 .env 并填入真实值

APP_NAME=HarmonyAI
APP_VERSION=0.3.0
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=harmonyai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=改成你自己的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM (Qwen-compatible / OpenAI-compatible)
# 不填则自动降级为本地规则引擎 — 核心流程仍可运行
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen2.5-7B-Instruct
HARMONYAI_REAL_AGENTS=false

# Music Generation (Agent 4, MiniMax Music API)
# 只从环境变量读取，禁止写入代码/测试/日志/Issue。
# MUSIC_PROVIDER=minimax 时要求 API Key 与有效模型齐全；缺配置时保持
# readiness not_configured（fail-closed），绝不伪装成功或静默切换 Mock。
# MUSIC_PROVIDER_BASE_URL 缺省使用官方 https://api.minimax.io
MUSIC_PROVIDER=
MUSIC_PROVIDER_BASE_URL=
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_MODEL=

# 生成的音频文件落盘根目录（Player 通过受控 /api/v3/music/assets/{id}/stream 读取）
HARMONY_MEDIA_ROOT=media

# CORS
CORS_ORIGINS=["*"]

# HarmonyAI Environment Configuration
# 复制此文件为 .env 并填入真实值

APP_NAME=HarmonyAI
APP_VERSION=0.3.0
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=harmonyai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=改成你自己的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM (Qwen-compatible / OpenAI-compatible)
# 不填则自动降级为本地规则引擎 — 核心流程仍可运行
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen2.5-7B-Instruct
HARMONYAI_REAL_AGENTS=false

# Music Generation (Agent 4)
# Sprint 5 正式真实 Provider：腾讯云 TokenHub / MiniMax Music（minimax-music-v3.0）
# 密钥只从环境变量读取，禁止写入代码/测试/日志/Issue/数据库/Git。
# 缺配置时保持 readiness not_configured（fail-closed），绝不伪装成功或静默切换 Mock。
MUSIC_PROVIDER=tokenhub
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com
TOKENHUB_MUSIC_MODEL=minimax-music-v3.0
TOKENHUB_API_KEY=

# 历史/未启用实现（保留代码，不启用；不得作为当前或备选 Provider）：
#   MUSIC_PROVIDER=stability → Stability Stable Audio 2.5（历史，未启用）
#   MUSIC_PROVIDER=minimax   → 直连 https://api.minimax.io/v1/music_generation
#                              （BLOCKED_BY_PROVIDER_ENTITLEMENT，禁止调用）

# 生成的音频文件落盘根目录（Player 通过受控 /api/v3/music/assets/{id}/stream 读取）
HARMONY_MEDIA_ROOT=media

# CORS
CORS_ORIGINS=["*"]

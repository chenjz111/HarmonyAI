# HarmonyAI Environment Configuration
# 复制此文件为 .env 并填入真实值

APP_NAME=HarmonyAI
APP_VERSION=1.0.0
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=harmonyai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=改成你自己的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["*"]

# HarmonyAI Environment Configuration
# 复制此文件为 .env 并填入真实值

APP_NAME=HarmonyAI
APP_VERSION=0.3.0
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=harmonyai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=改成你自己的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM (Qwen-compatible / OpenAI-compatible)
# 不填则自动降级为本地规则引擎 — 核心流程仍可运行
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen2.5-7B-Instruct
HARMONYAI_REAL_AGENTS=false

# CORS
CORS_ORIGINS=["*"]

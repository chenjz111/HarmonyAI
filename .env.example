# HarmonyAI Environment Configuration
# 复制此文件为 .env 并填入真实值

APP_NAME=HarmonyAI
APP_VERSION=0.3.0
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=harmonyai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=改成你自己的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM (Qwen-compatible / OpenAI-compatible)
# 不填则自动降级为本地规则引擎 — 核心流程仍可运行
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen2.5-7B-Instruct
HARMONYAI_REAL_AGENTS=false

# Music Generation (Agent 4)
# Sprint 5 真实 Provider：Stability AI Stable Audio 2.5（OWNER_APPROVED）。
# 密钥只从环境变量读取，禁止写入代码/测试/日志/Issue。
# MUSIC_PROVIDER=stability 时要求 STABILITY_API_KEY 齐全；缺配置时保持
# readiness not_configured（fail-closed），绝不伪装成功或静默切换 Mock。
MUSIC_PROVIDER=stability
MUSIC_PROVIDER_MODEL=stable-audio-2.5
MUSIC_PROVIDER_BASE_URL=https://api.stability.ai
STABILITY_API_KEY=

# MiniMax 已由 Owner 标记 BLOCKED_BY_PROVIDER_ENTITLEMENT（HTTP 410/2153），
# Sprint 5 不启用；adapter 保留为历史参考。不要将 MUSIC_PROVIDER 设为 minimax。
# MUSIC_PROVIDER_API_KEY=

# 生成的音频文件落盘根目录（Player 通过受控 /api/v3/music/assets/{id}/stream 读取）
HARMONY_MEDIA_ROOT=media

# CORS
CORS_ORIGINS=["*"]

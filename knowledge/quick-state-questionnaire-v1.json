  "pre_post_usage": {
    "pre": "听前填写全部 6 题",
    "post": "听后重复前 5 题（qs01-qs05），Feedback Agent 计算 delta = post - pre",
    "delta_schema": {
      "tension_worry_delta": "int (-10 to 10)",
      "overthinking_delta": "int (-10 to 10)",
      "low_mood_delta": "int (-10 to 10)",
      "body_tension_delta": "int (-10 to 10)",
      "mental_fatigue_delta": "int (-10 to 10)"
    },
    "note": "delta 只更新个人偏好与即时状态，不修改全局医学规则（契约：Feedback 只影响个人偏好）"
  },
  "relationship": {
    "full_to_quick": "快速问卷 6 题对应完整问卷的当下状态版（0-10），与 20 题（0-4 频率）互补：20 题评估长期状态，快速问卷评估当下状态",
    "usage": "完整问卷 V2.1 用于首次/定期评估；快速问卷用于每次听音乐前后"

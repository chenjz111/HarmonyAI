{
  "schema_version": "questionnaire_scoring_v2.1",
  "collection_id": "harmonyai-questionnaire-scoring-v2.1",
  "version": "2.1",
  "created": "2026-08-06",
  "updated": "2026-08-09",
  "author": "nob",
  "status": "review_pending",
  "spec_ref": "docs/sprint4/questionnaire-contract-v2.1.md §7",
  "scoring_principles": [
    "single_question_no_diagnosis: 单题不能直接决定证型，证型由领域聚合 + 多源证据共同确定",
    "every_scored_question_has_dimension: 每道计分题明确标注对应维度",
    "safety_questions_bypass_scoring: 安全题只做分流入安全流程，不参与状态评分",
    "visual_questions_preserve_semantics_and_values: 视觉题同时保存语义字符串和数值分数",
    "appetite_direction_preserved_separately: 食欲变化必须分方向 increase/decrease/none，不简单合并",
    "reverse_scored_explicit: 正向题标记 reverse_scored: true"
  ],
  "display_layers": [
    {
      "range": [
        0.0,
        0.75
      ],
      "label": "当前不明显",
      "note": "非临床阈值，仅内部状态分层"
    },
    {
      "range": [
        0.76,
        1.75
      ],
      "label": "轻微出现",
      "note": "非临床阈值，仅内部状态分层"
    },
    {
      "range": [
        1.76,
        2.75
      ],
      "label": "有一定表现",
      "note": "非临床阈值，仅内部状态分层"
    },
    {
      "range": [
        2.76,
        3.5
      ],
      "label": "较明显",
      "note": "非临床阈值，仅内部状态分层"
    },
    {
      "range": [
        3.51,
        4.0
      ],
      "label": "持续或非常明显",
      "note": "非临床阈值，仅内部状态分层"
    }
  ],
  "dimensions": {
    "tension_worry": {
      "source_question": "q03_tension_worry",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "worry_control": {
      "source_question": "q04_worry_control",
      "type": "frequency_0_4",
      "scored": false,
      "reverse_scored": false,
      "weight": 0,
      "aggregation": "qualitative",
      "notes": "定性记录，输出到 context.worry_control，不参与 tension_worry 聚合，避免 double-count（契约方案A）"
    },
    "overthinking": {
      "source_question": "q05_overthinking",
      "type": "visual_single",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct",
      "score_map": {
        "calm": 0,
        "ripple": 1,
        "waves": 2,
        "swell": 3,
        "storm": 4
      }
    },
    "irritability_anger": {
      "source_question": "q06_irritability_anger",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "fear_unease": {
      "source_question": "q07_fear_unease",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "low_mood": {
      "source_question": "q08_low_mood",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "interest_loss": {
      "source_question": "q09_interest_loss",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "calm_wellbeing": {
      "source_question": "q10_calm_wellbeing",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": true,
      "weight": 1.0,
      "aggregation": "direct_reverse",
      "reverse_formula": "calm_wellbeing_reversed = 4 - raw_score"
    },
    "emotional_recovery": {
      "source_question": "q11_emotional_recovery",
      "type": "single_choice",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct",
      "score_map": {
        "quick": 0,
        "fast": 1,
        "moderate": 2,
        "slow": 3,
        "very_slow": 4
      }
    },
    "sleep_disturbance": {
      "source_question": "q12_sleep_disturbance",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "domain_average",
      "domain": "sleep",
      "notes": "Q12=入睡过程问题"
    },
    "unrefreshing_sleep": {
      "source_question": "q13_unrefreshing_sleep",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "domain_average",
      "domain": "sleep",
      "notes": "Q13=醒来感受，与 Q12 区分"
    },
    "low_energy": {
      "source_question": "q14_low_energy",
      "type": "visual_single",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct",
      "score_map": {
        "full": 0,
        "half": 2,
        "empty": 4
      }
    },
    "appetite_change": {
      "source_question": "q15_appetite_change",
      "type": "single_choice",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "directional",
      "notes": "保存 {direction: increase|decrease|none, severity: 0-4}。direction=none 时 severity 强制为 0",
      "direction_values": [
        "increase",
        "decrease",
        "none"
      ]
    },
    "daily_impact": {
      "source_question": "q18_daily_impact",
      "type": "frequency_0_4",
      "scored": true,
      "reverse_scored": false,
      "weight": 1.0,
      "aggregation": "direct"
    },
    "physical_signals": {
      "source_question": "q16_physical_signals",
      "type": "multi_choice",
      "scored": false,
      "reverse_scored": false,
      "weight": 0,
      "aggregation": "evidence_only",
      "notes": "只记录证据（evidence items），不直接映射证型",
      "mutually_exclusive_value": "none"
    }
  },
  "qualitative_fields": {
    "worry_control": {
      "source": "q04_worry_control",
      "notes": "定性记录，避免与 tension_worry double-count"
    },
    "user_goal": {
      "source": "q01_user_goal",
      "notes": "影响音乐目标，不计分。8 个固定 option value 与 Frozen Contract 统一"
    },
    "duration": {
      "source": "q17_duration",
      "notes": "不计分，影响评估时长维度"
    },
    "mood_weather": {
      "source": "q02_mood_weather",
      "notes": "表达辅助，不计分"
    }
  },
  "domain_aggregation": {
    "formula": "维度得分 = Σ(题目得分 × 题目权重) / Σ(题目权重)",
    "domains": {
      "sleep": {
        "label": "睡眠领域",
        "members": [
          {
            "question": "q12_sleep_disturbance",
            "weight": 1.0,
            "note": "Q12=入睡过程"
          },
          {
            "question": "q13_unrefreshing_sleep",
            "weight": 1.0,
            "note": "Q13=醒来感受"
          }
        ],
        "example": "sleep_disturbance = (Q12 × 1.0 + Q13 × 1.0) / 2.0"
      },
      "negative_affect": {
        "label": "负性情绪领域",
        "members": [
          {
            "question": "q03_tension_worry",
            "weight": 1.0
          },
          {
            "question": "q06_irritability_anger",
            "weight": 1.0
          },
          {
            "question": "q07_fear_unease",
            "weight": 1.0
          },
          {
            "question": "q08_low_mood",
            "weight": 1.0
          }
        ],
        "notes": "仅用于展示聚合，单题不直接决定证型"
      },
      "cognitive": {
        "label": "认知领域",
        "members": [
          {
            "question": "q05_overthinking",
            "weight": 1.0
          },
          {
            "question": "q04_worry_control",
            "weight": 0,
            "note": "定性，不参与数值聚合"
          }
        ],
        "notes": "worry_control 只作上下文标签"
      }
    }
  },
  "reverse_scoring": {
    "calm_wellbeing": {
      "formula": "4 - raw_score",
      "note": "高分=好状态，反向计分后高分=状态差"
    }
  },
  "appetite_handling": {
    "format": {
      "appetite_change": {
        "direction": "decrease|increase|none",
        "severity": 0,
        "severity_display": "较明显下降",
        "source": "q15_appetite_change"
      }
    },
    "rules": [
      "direction=none 时 severity 强制为 0",
      "direction 必须显式保存，不允许简单合并为单一分数"
    ]
  },
  "safety_routing": {
    "rules": [
      {
        "trigger": "q19_self_harm 选择 fleeting/sometimes/often/specific_plan（即除 never 外的任何选项）",
        "flag": "SAFETY_SELF_HARM",
        "action": "进入安全流程，不进入 Diagnosis/Prescription/Music"
      },
      {
        "trigger": "q20_emergency 选择任何紧急情况",
        "flag": "SAFETY_EMERGENCY_PHYSICAL",
        "action": "进入安全流程，不进入 Diagnosis/Prescription/Music"
      }
    ],
    "mutual_exclusivity": [
      {
        "question": "q20_emergency",
        "mutually_exclusive_value": "none",
        "rule": "选择 none 时必须清除其他选项；选择任一紧急选项时必须清除 none"
      },
      {
        "question": "q16_physical_signals",
        "mutually_exclusive_value": "none",
        "rule": "选择 none 时必须清除其他身体信号"
      }
    ],
    "bypass": "Q19/Q20 答案不进入状态评分"
  },
  "evidence_coverage_score": {
    "formula": "evidence_coverage_score = 有证据的维度数 / 总维度数",
    "total_dimensions": 14,
    "note": "独立计算，不再乘 source_diversity（Frozen Contract 更新）"
  },
  "result_display_chain": [
    "raw 得分计算（含反向计分）",
    "领域聚合（加权平均）",
    "display_layers 分层映射",
    "evidence_coverage_score 独立计算",
    "source_diversity 独立计算",
    "安全分流检查（Q19/Q20 优先）"
  ],
  "output_schema": {
    "dimension_scores": {
      "tension_worry": 0.0,
      "overthinking": 0,
      "irritability_anger": 0,
      "fear_unease": 0,
      "low_mood": 0,
      "interest_loss": 0,
      "calm_wellbeing": 0,
      "emotional_recovery": 0,
      "sleep_disturbance": 0,
      "unrefreshing_sleep": 0,
      "low_energy": 0,
      "daily_impact": 0
    },
    "domain_scores": {
      "sleep": 0.0,
      "negative_affect": 0.0,
      "cognitive": 0.0
    },
    "qualitative": {
      "worry_control": null,
      "user_goal": null,
      "duration": null,
      "mood_weather": null
    },
    "appetite": {
      "direction": null,
      "severity": 0
    },
    "physical_signals": [],
    "safety_flags": [],
    "display_levels": {},
    "evidence_coverage_score": 0.0,
    "candidate_syndromes": []
  },
  "combination_principles": {
    "rule": "candidate_syndromes 只能在组合/领域层输出，单题不直接给出证型候选",
    "note": "证型候选由领域聚合 + 多源证据共同确定，作为后续组合分析候选"
  },
  "evidence_legend": {
    "direct": "直接证据",
    "mechanism": "病机相关",
    "analogous_syndrome": "旁证-同类证型",
    "five_element": "旁证-五行归属",
    "classical": "经典理论/理论依据"
  },
  "source_diversity": {
    "formula": "source_diversity = min(1.0, 不同 source_type 数量 / 3)",
    "note": "与 evidence_coverage_score 独立输出，两者不互相影响"
  }
}

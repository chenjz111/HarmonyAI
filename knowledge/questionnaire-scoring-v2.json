{
  "schema_version": "questionnaire_scoring_v2.0",
  "collection_id": "questionnaire-scoring-v2",
  "version": "1.0.0",
  "created": "2026-07-28",
  "updated": "2026-07-31",
  "author": "肖宇翔（nob）· Medical Knowledge Engineer",
  "status": "reviewed-by-nob",
  "spec_ref": "docs/questionnaire-v2-design.md 第 5-7 节",
  "scoring_principles": {
    "deterministic": "所有问卷分数可复现，不由 Qwen 自由生成",
    "score_range": "raw 0-4, normalized 0-100",
    "exclude_from_scoring": ["q01_mood_weather", "q12_physical_safety"],
    "backend_authoritative": "dimension_scores 由后端重新计算，不能信任前端提交值",
    "single_question_no_diagnosis": "单题不能直接决定证型或情绪；组合维度才有 candidate_syndromes",
    "Qwen_independent_safety": "Qwen 不可用时安全规则仍生效"
  },
  "dimensions": {
    "tension_worry": {
      "source_question": "q02_tension_worry",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "overthinking": {
      "source_question": "q03_overthinking",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25",
      "score_map": {"calm": 0, "ripple": 1, "waves": 2, "swell": 3, "storm": 4}
    },
    "irritability_anger": {
      "source_question": "q04_irritability_anger",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "low_mood": {
      "source_question": "q05_low_mood",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "interest_loss": {
      "source_question": "q06_interest_loss",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "fear_unease": {
      "source_question": "q07_fear_unease",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "sleep_disturbance": {
      "source_question": "q08_sleep_disturbance",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "low_energy": {
      "source_question": "q09_low_energy",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25",
      "score_map": {"full": 0, "three_quarters": 1, "half": 2, "quarter": 3, "empty": 4}
    },
    "appetite_change": {
      "source_question": "q10_appetite_change",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    },
    "daily_impact": {
      "source_question": "q11_daily_impact",
      "raw_score_range": [0, 4],
      "weight": 1.0,
      "normalization_formula": "raw × 25"
    }
  },
  "combinations": {
    "紧张负担": {
      "dimensions": ["tension_worry", "fear_unease"],
      "method": "average",
      "label": "紧张与恐惧",
      "purpose": "反映情绪紧张与不安的整体状态",
      "candidate_syndromes": ["syd_001", "syd_003", "syd_007", "syd_008"]
    },
    "反复思虑": {
      "dimensions": ["overthinking"],
      "method": "value",
      "label": "反复思虑",
      "purpose": "单维度直接呈现",
      "candidate_syndromes": ["syd_004", "syd_005"]
    },
    "烦躁状态": {
      "dimensions": ["irritability_anger"],
      "method": "value",
      "label": "烦躁易怒",
      "purpose": "单维度直接呈现",
      "candidate_syndromes": ["syd_001", "syd_003"]
    },
    "低落与兴趣": {
      "dimensions": ["low_mood", "interest_loss"],
      "method": "average",
      "label": "低落与兴趣下降",
      "purpose": "反映抑郁倾向",
      "candidate_syndromes": ["syd_002", "syd_006"]
    },
    "身体与生活负担": {
      "dimensions": ["sleep_disturbance", "low_energy", "appetite_change", "daily_impact"],
      "method": "average",
      "label": "身体与生活负担",
      "purpose": "反映睡眠/精力/食欲/功能综合负担",
      "candidate_syndromes": ["syd_002", "syd_004", "syd_005", "syd_006"]
    }
  },
  "severity_labels": [
    {"range": [0, 24], "normalized_label": "当前较少", "frequency_phrase": "过去 7 天很少出现"},
    {"range": [25, 49], "normalized_label": "轻度出现", "frequency_phrase": "过去 7 天有时出现"},
    {"range": [50, 74], "normalized_label": "较明显", "frequency_phrase": "过去 7 天较常出现"},
    {"range": [75, 100], "normalized_label": "频繁出现", "frequency_phrase": "过去 7 天频繁或几乎每天出现"}
  ],
  "severity_disclaimer": "这些标签表示过去 7 天的客观主观频率，不代表临床严重程度",
  "result_display_chain": {
    "order": [
      "原始症状（用户回答）",
      "维度分数（归一化 0-100）",
      "情绪推测",
      "辅助辨证倾向"
    ],
    "constraints": [
      "输出只能称'状态评估'或'辅助辨证倾向'",
      "每条辨证倾向至少显示一条可理解依据",
      "页面固定显示'不构成医学诊断'声明"
    ]
  },
  "non_scoring_outputs": {
    "q01_mood_weather": {
      "output_field": "context.mood_metaphor",
      "value_options": ["sunny", "lightly_cloudy", "cloudy", "rainy", "stormy"],
      "purpose": "提供用户可理解的表达入口"
    },
    "q12_physical_safety": {
      "output_field": "context.physical_signals",
      "value_options": "array of selected physical_signal values",
      "safety_field": "safety_flags",
      "purpose": "提供身体背景与风险筛查"
    }
  },
  "output_schema": {
    "schema_version": "questionnaire_v2.0",
    "time_window_days": 7,
    "started_at": "ISO8601 string",
    "completed_at": "ISO8601 string",
    "answers": [
      {
        "question_id": "string",
        "type": "enum[visual_single|frequency_0_4|visual_multi]",
        "value": "string|number|array",
        "score": "number|null"
      }
    ],
    "dimension_scores": {
      "tension_worry": 0,
      "overthinking": 0,
      "irritability_anger": 0,
      "low_mood": 0,
      "interest_loss": 0,
      "fear_unease": 0,
      "sleep_disturbance": 0,
      "low_energy": 0,
      "appetite_change": 0,
      "daily_impact": 0
    },
    "context": {
      "mood_metaphor": "string",
      "physical_signals": ["string"]
    },
    "safety_flags": ["string"],
    "completion_seconds": 0
  },
  "evidence_legend": {
    "五级证据标记": "[直接证据]/[病机相关]/[旁证-同类证型]/[旁证-五行归属]/[经典理论]（详见 emotion-to-syndrome.json）",
    "本地扩展": "该标记体系为 nob 本地扩展，未写入陈家智 knowledge-architecture.md spec"
  }
}
